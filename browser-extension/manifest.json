{
  "manifest_version": 3,
  "name": "Jarvis Browser Bridge",
  "version": "1.0.0",
  "description": "Ponte WebSocket para controle autônomo do navegador via Jarvis AI.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
